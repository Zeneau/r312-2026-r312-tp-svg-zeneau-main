---
import Layout from "../../layouts/Layout.astro";
import BasketProfil from "../../components/BasketProfil.astro";
import db from "../../lib/db.js";
import type { Basket } from "../../lib/db.js";

const baskets: Basket[] = db.prepare("SELECT * FROM BASKETS").all();
---

<Layout>
	<main class="min-h-screen bg-base-200 px-4 py-8 sm:px-6 lg:px-10">
		<div class="mx-auto max-w-7xl">
			<header class="mb-10 flex flex-col gap-5 rounded-box bg-neutral p-6 text-neutral-content shadow-xl sm:p-8 lg:flex-row lg:items-end lg:justify-between">
				<div>
					<div class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-warning">
						<span class="h-2 w-2 rounded-full bg-warning"></span>
						Collection personnelle
					</div>
					<h1 class="text-4xl font-black tracking-tight sm:text-5xl">Mes baskets</h1>
					<p class="mt-3 max-w-xl text-base text-neutral-content/75 sm:text-lg">
						Retrouvez toutes vos créations et imaginez la prochaine paire qui vous ressemble.
					</p>
				</div>
				<div class="stats bg-neutral-focus text-neutral-content shadow-none">
					<div class="stat px-5 py-3">
						<div class="stat-title text-neutral-content/60">Créations</div>
						<div class="stat-value text-warning">{baskets.length}</div>
					</div>
				</div>
			</header>

			{
				baskets.length > 0 ? (
					<section aria-label="Liste des baskets" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{baskets.map((basket, index) => (
							<article class="card overflow-hidden border border-base-300 bg-base-100 shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-2xl">
								<figure class="relative flex min-h-56 items-center justify-center overflow-hidden bg-base-200 px-4 pt-5">
									<div class="absolute left-5 top-4 badge badge-neutral">#{String(index + 1).padStart(2, "0")}</div>
									<BasketProfil
										semelle={basket.semelle}
										empeigne={basket.empeigne}
										pointe={basket.pointe}
										oeillet={basket.oeillet}
										bande={basket.bande}
										languette={basket.languette}
										lacet={basket.lacet}
										trimestre={basket.trimestre}
									/>
								</figure>
								<div class="card-body gap-4">
									<div>
										<h2 class="card-title text-xl">{basket.description?.trim() || "Basket sans nom"}</h2>
										<p class="mt-1 text-sm text-base-content/60">Créée à partir de votre configuration</p>
									</div>
									<div class="flex items-center gap-2" aria-label="Palette de couleurs">
										{[basket.empeigne, basket.pointe, basket.lacet, basket.semelle].map((color) => (
											<span class="h-5 w-5 rounded-full border-2 border-base-100 shadow ring-1 ring-base-300" style={`background-color: ${color}`}></span>
										))}
										<span class="ml-1 text-xs font-medium text-base-content/50">Palette personnalisée</span>
									</div>
									<div class="card-actions mt-auto justify-between">
										<a class="btn btn-primary btn-sm" href={`/baskets/${basket.id}`}>Modifier cette basket <span aria-hidden="true">→</span></a>
										<form method="POST" action={`/baskets/${basket.id}?action=delete`} onsubmit="return confirm('Supprimer cette basket ?');">
											<button class="btn btn-error btn-sm" type="submit">Supprimer</button>
										</form>
									</div>
								</div>
							</article>
						))}
					</section>
				) : (
					<div class="hero rounded-box border border-base-300 bg-base-100 py-20 shadow-lg">
						<div class="hero-content text-center">
							<div class="max-w-md">
								<h2 class="text-3xl font-bold">Votre collection est vide</h2>
								<p class="py-6 text-base-content/70">Commencez par créer une paire et elle apparaîtra ici.</p>
								<a class="btn btn-primary" href="/configurateur">Créer ma première basket</a>
							</div>
						</div>
					</div>
				)
			}
		</div>
	</main>
</Layout>
