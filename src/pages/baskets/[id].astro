---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import ModifierBasket from "../../components/modifierBasket.astro";
import db from "../../lib/db.js";
import type { Basket } from "../../lib/db.js";

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();

	if (formData.get("action") === "delete") {
		db.run("DELETE FROM BASKETS WHERE id = ?", [Number(Astro.params.id)]);
		return Astro.redirect("/baskets", 303);
	}
}

const basket = db
	.prepare("SELECT * FROM BASKETS WHERE id = ?")
	.get(Number(Astro.params.id)) as Basket | null;

if (!basket) {
	return Astro.redirect("/baskets");
}
---

<Layout>
	<ModifierBasket {...basket} />
</Layout>
